# HomeDDNS Development Environment Variables
# Copy this file to .env.local and fill in your credentials

# Logging Configuration
# LOG_LEVEL can be: debug, info, warn, error (default: info)
# Set to "debug" or "true" to enable debug logging
LOG_LEVEL=info

# Server Configuration
PORT=8080

# SSL/TLS Configuration (optional)
SSL=false
CERTFILE=/path/to/fullchain.pem
KEYFILE=/path/to/privkey.pem

# Authentication (plain text password, compared in constant time)
AUTH_USERNAME=dyndns
AUTH_PASSWORD=your-secure-password

# DNS Provider (netcup_ccp or aws_route53; default: netcup_ccp)
DNS_PROVIDER=netcup_ccp
# Optional for the server, required for the update command
DOMAIN=example.com
DNS_TTL=60

# Hostname authorization (comma-separated, *.suffix allowed; empty = all)
# ALLOWED_HOSTNAMES=home.example.com,*.dyn.example.com

# IP handling
# TRUSTED_PROXIES=10.0.0.0/8,fd00::/8
# ALLOW_PRIVATE_IPS=false
# CLEANUP_STALE_RECORD=false

# Netcup Credentials
NETCUP_CUSTOMER_NUMBER=123456
NETCUP_API_KEY=your-api-key
NETCUP_API_PASSWORD=your-api-password

# AWS Route53 Credentials (alternative to Netcup)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# ROUTE53_ZONE_ID=Z0123456789ABCDEFGHIJ
